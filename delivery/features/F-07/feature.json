    {
      "id": "QA-1-1",
      "round": 1,
      "snapshot_ref": "195926d6854956a6918ef6199c0a5f57ce3a32ad",
      "owner": "frontend",
      "severity": "low",
      "blocking": false,
      "summary": "An opaque `case_id` containing reserved characters is encoded twice. `/projects/P%2F..%3Cb%3E` sent `GET /api/v1/projects/P%252F..%253Cb%253E`, because Next hands the route param already encoded and openapi-fetch encodes it again. Expected: one level of encoding, so the backend sees the same id the URL carried. Actual: the id the server decodes is `P%2F..%3Cb%3E`. Real ids are uuids (REC-CASE), so there is no impact today, and the mock falls back to the default journey for unknown ids. The fix is to decodeURIComponent the segment before the client call, in `frontend/src/features/projects/useProject.ts` or the route page. Check this when FE-CONNECT-1 meets the real API.",
      "reproduction": null,
      "evidence_refs": [
        "delivery/features/F-07/round-1/review-qa.md"
      ],
      "raised_by": "reviewer-qa",
      "state": "FIX_SUBMITTED",
