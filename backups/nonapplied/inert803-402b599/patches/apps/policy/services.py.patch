+def _resolution_candidate(component, case):
+    """Stream local identities, preserving the exhaustive latest-state pass.
+
+    Do not stop after the first eligible version: malformed later history must
+    retain its native failure. This defers unselected LOCAL envelopes only;
+    chosen/inherited payload validation and READ COMMITTED semantics are intact.
+    Chunking limits queryset caching, not total database work or driver memory.
+    """
+    versions = Configuration.objects.filter(case=case, component=component).only(
+        'id', 'case_id', 'component', 'revision').order_by('-revision')
+    candidate = None
+    for config in versions.iterator(chunk_size=100):
+        state = config.states.order_by('-pk').first().state
+        if state in ['active', 'revoked', 'superseded'] and candidate is None:
+            candidate = config
+    return candidate
+
