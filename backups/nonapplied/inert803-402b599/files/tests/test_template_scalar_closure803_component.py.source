import ast,unittest
from pathlib import Path
ROOT=Path(__file__).resolve().parents[1]
class ScalarClosureComponentTests(unittest.TestCase):
    def test_strict_selection(self):
        tree=ast.parse((ROOT/'apps/documents/template_scalar_closure.py').read_text());names={'selection','hold'}
        class Error(Exception):pass
        ns={'DOMAINS':{'claim':1,'retraction':2,'resolution':3},'MAX_SELECTED':100,'MESSAGE':'hold','ValidationError':Error}
        exec(compile(ast.Module(body=[n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name in names],type_ignores=[]),'<pure>','exec'),ns)
        self.assertEqual(ns['selection']({'claim':[2,1]}),{'claim':(1,2)})
        for v in ({},{'claim':[True]},{'claim':[1,1]},{'other':[1]},{'claim':list(range(1,102))}):
            with self.assertRaises(Error):ns['selection'](v)
    def test_scalar_only_no_authority_or_payload(self):
        s=(ROOT/'apps/documents/template_scalar_closure.py').read_text();t=ast.parse(s)
        calls={ast.unparse(n.func).split('.')[-1] for n in ast.walk(t) if isinstance(n,ast.Call)}
        self.assertFalse(calls & {'visible_templates','owner_current','public_evidence','status','active_claims','select_related'})
        self.assertNotIn('finance',s.lower());self.assertNotIn('claim_ids',s)
        self.assertIn("values_list('pk',scopefield,'evidence_id')",s)
        self.assertIn(".distinct()[:MAX_SCOPES+1]",s)
    def test_opaque_output_and_separate_scalar_budget(self):
        s=(ROOT/'apps/documents/template_scalar_closure.py').read_text()
        self.assertIn('@dataclass(frozen=True,repr=False)',s);self.assertIn('MAX_IDENTITIES=400',s)
        self.assertIn('_CONTEXT.get() is not self.marker',s)
    def test_shared_identity_dedup_and_limits(self):
        s=(ROOT/'apps/documents/template_scalar_closure.py').read_text()
        self.assertIn("marker.setdefault('scalar_closure_budget803'",s)
        self.assertIn("type(pk) is not int",s)
        self.assertLess(s.index('any(type(pk) is not int or pk<=0 for pk in ids):self.fail()'),s.index('new=frozenset'))
        self.assertIn('MAX_PHASES=1000',s)
