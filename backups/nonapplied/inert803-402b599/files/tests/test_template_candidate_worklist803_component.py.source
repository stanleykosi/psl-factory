"""Pure fake inventory and AST contracts, not native ORM/privacy equivalence."""
import ast,unittest
from pathlib import Path
from types import SimpleNamespace
from datetime import datetime,timezone
from uuid import UUID,uuid4
from dataclasses import dataclass
SOURCE=Path(__file__).resolve().parents[1]/'apps/documents/template_candidate_worklist.py'
class Hold(Exception):pass
class CandidateTests(unittest.TestCase):
    def setUp(self):
        self.marker={};self.actor=SimpleNamespace(pk=1);self.raw=object();self.connection=object();outer=self
        class Guard:
            def __init__(self,actor,keys):
                self.actor=actor;self.keys=tuple(keys);self.marker=outer.marker;self.connection=outer.connection;self.raw_connection=outer.raw;self.context()
            def context(self):
                if self.actor is not outer.actor or self.actor.pk!=1 or self.marker is not outer.marker or self.raw_connection is not outer.raw or self.connection is not outer.connection or self.marker.get('policy_budget_v2_failed'):self.poison();raise Hold()
            def poison(self):self.marker['policy_budget_v2_failed']=True;outer.marker['policy_budget_v2_failed']=True
        tree=ast.parse(SOURCE.read_text());nodes=[n for n in tree.body if not isinstance(n,(ast.Import,ast.ImportFrom))]
        self.ns={'dataclass':dataclass,'datetime':datetime,'UUID':UUID,'ValidationError':Hold,'ScalarClosureBudget':Guard,'_CONTEXT':SimpleNamespace(get=lambda:self.marker),'_poison_marker':lambda m:m.update(policy_budget_v2_failed=True)}
        exec(compile(ast.Module(body=nodes,type_ignores=[]),'<pure-worklist>','exec'),self.ns)
    def budget(self):return self.ns['_Budget'](self.actor,['documents.template_claims'])
    def test_all_category_exact_limits_and_repeated_wrapper_no_reset(self):
        for kind in self.ns['KINDS']:self.budget().charge(kind,list(range(1,101)))
        self.assertEqual(len(self.budget().state['ids']),400)
        with self.assertRaises(Hold):self.budget().charge('template',[101])
        self.assertTrue(self.marker['policy_budget_v2_failed'])
    def test_each_101_and_bool_before_dedup(self):
        for kind in self.ns['KINDS']:
            for ids in (list(range(1,102)),[1,True]):
                self.setUp();b=self.budget()
                with self.assertRaises(Hold):b.charge(kind,ids)
                self.assertFalse(b.state['ids'])
    def test_phase_reuse_and_context_rollover(self):
        for _ in range(1000):self.budget().phase()
        with self.assertRaises(Hold):self.budget().phase()
        self.setUp();b=self.budget();old=self.marker;self.marker={}
        with self.assertRaises(Hold):b.context()
        self.assertTrue(old['policy_budget_v2_failed']);self.assertTrue(self.marker['policy_budget_v2_failed'])
    def test_actor_raw_connection_changes(self):
        for field in ('actor','raw','connection'):
            self.setUp();b=self.budget();setattr(self,field,object())
            with self.assertRaises(Hold):b.context()
    def test_rows_preserve_nullable_report_cross_cases_shared_run_and_types(self):
        b=self.budget();case1,case2=uuid4(),uuid4();stamp=datetime.now(timezone.utc)
        finance=[(1,7,10,2,3,'statement',case1,'tenant',True),(2,7,11,2,3,'statement',case1,'tenant',True)]
        pmo=[(4,10,None,5,2,3,stamp,case2,None),(5,12,6,None,2,3,stamp,case2,case1)]
        self.assertEqual(self.ns['_rows'](b,finance,'finance',(2,)),tuple(finance))
        self.assertEqual(self.ns['_rows'](b,pmo,'pmo',(2,)),tuple(pmo))
        b.charge('version',[10,11,12]);self.assertEqual(sum(k=='version' for k,_ in b.state['ids']),3)
    def test_pmo_naive_timestamp_rejected_before_identity_charge(self):
        b=self.budget()
        row=(4,10,None,5,2,3,datetime(2026,1,1),uuid4(),None)
        with self.assertRaises(Hold):self.ns['_rows'](b,[row],'pmo',(2,))
        self.assertFalse(b.state['ids'])
        self.assertTrue(self.marker['policy_budget_v2_failed'])
    def test_row_shape_and_template_mismatch_hold(self):
        for row in [(1,2,3,999,5,'statement',uuid4(),'x',True),(True,2,3,4,5,'statement',uuid4(),'x',True)]:
            self.setUp()
            with self.assertRaises(Hold):self.ns['_rows'](self.budget(),[row],'finance',(4,))
    def test_exact_native_query_shapes_and_no_reader_or_payload(self):
        tree=ast.parse(SOURCE.read_text());fn=next(n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name=='discover_candidate_worklist');text=ast.unparse(fn)
        self.assertEqual([a.arg for a in fn.args.args],['fresh_actor','case_id','selections','keys'])
        self.assertIn('discover_template_owner_closure(fresh_actor, case_id, selections, budget.guard)',text)
        for fragment in ("definition__document_type='accepted_finance_metadata'","document__case=case, forecastbinding__isnull=False","manifest__source_mode='leadership_selected_facts/v1'","values_list(*FINANCE_FIELDS)[:101]","values_list(*PMO_FIELDS)[:101]"):
            self.assertIn(fragment,text)
        for forbidden in ('recipient_access','binding_access','select_related','document__current','report_id__isnull','definition__contains'):
            self.assertNotIn(forbidden,text)
        self.assertEqual(text.count('budget.phase()'),6)
    def test_failure_poison_before_partial_output(self):
        self.ns['discover_template_owner_closure']=lambda *args:(_ for _ in ()).throw(Hold('closure'))
        with self.assertRaises(Hold):self.ns['discover_candidate_worklist'](self.actor,uuid4(),{},['documents.template_claims'])
        self.assertTrue(self.marker['policy_budget_v2_failed'])
    def producer_fakes(self,fail_pmo=False,finance_read=False):
        outer=self;self.calls=[];self.financial=[(1,7,10,2,3,'statement',uuid4(),'tenant',True)]
        self.pmo_rows=[(4,10,None,5,2,3,datetime.now(timezone.utc),uuid4(),None)]
        class Query:
            def __init__(self,name):self.name=name
            def filter(self,**kw):outer.calls.append((self.name,'filter',kw));return self
            def exclude(self,**kw):outer.calls.append((self.name,'exclude',kw));return self
            def order_by(self,*args):return self
            def distinct(self):return self
            def values(self,*args):return self
            def values_list(self,*args,**kw):outer.calls.append((self.name,'fields',args));return self
            def exists(self):return finance_read
            def get(self,**kw):return SimpleNamespace(pk=kw['pk'])
            def __getitem__(self,slice_):
                outer.assertEqual(slice_.stop,101)
                if self.name=='pmo' and fail_pmo:raise Hold('query')
                return {'template':[2],'finance':outer.financial,'pmo':outer.pmo_rows}[self.name]
        for key,name in [('Case','case'),('Grant','grant'),('Template','template'),('Version','version'),('FinanceDocumentBinding','finance'),('MinutesReportBinding','pmo')]:self.ns[key]=SimpleNamespace(objects=Query(name))
        self.ns['require']=lambda *args:None
        self.closure_calls=[]
        def closure(actor,case,selections,budget):
            self.closure_calls.append(case);return SimpleNamespace(_templates=(2,8))
        self.ns['discover_template_owner_closure']=closure
    def test_actual_producer_union_witness_and_nullable_rows(self):
        self.producer_fakes();case=uuid4()
        out=self.ns['discover_candidate_worklist'](self.actor,case,{'claim':[1]},['documents.template_claims'])
        self.assertEqual(out.versions,(10,));self.assertEqual(out.closure._templates,(2,8));self.assertEqual(out.candidate_templates,(2,))
        self.assertEqual(out.pmo[0][2],None);self.assertEqual(out.witness.case_id,case)
        self.assertIs(out.witness.actor,self.actor);self.assertIs(out.witness.raw,self.raw)
        case2=uuid4();out2=self.ns['discover_candidate_worklist'](self.actor,case2,{'claim':[1]},['documents.template_claims'])
        self.assertEqual(self.closure_calls,[case,case2]);self.assertEqual(out2.witness.case_id,case2)
        self.assertEqual(self.budget().state['phases'],12)
        self.assertEqual(len(self.budget().state['ids']),5)
    def test_actual_producer_late_failure_and_finance_gate_branch(self):
        self.producer_fakes(fail_pmo=True)
        with self.assertRaises(Hold):self.ns['discover_candidate_worklist'](self.actor,uuid4(),{},['documents.template_claims'])
        self.assertTrue(self.marker['policy_budget_v2_failed'])
        self.assertIn(('finance',1),self.marker['template_candidate_worklist803']['ids'])
        self.setUp();self.producer_fakes(finance_read=True)
        self.ns['discover_candidate_worklist'](self.actor,uuid4(),{},['documents.template_claims'])
        excludes=[kw for name,action,kw in self.calls if action=='exclude']
        self.assertEqual(excludes,[{'definition__document_type':'accepted_finance_metadata'}])
    def test_case_canonical_and_frozen_private_result(self):
        a,b=uuid4(),uuid4();self.assertEqual(self.ns['case_uuid'](str(a)),a)
        with self.assertRaises((ValueError,Hold)):self.ns['case_uuid'](True)
        budget=self.budget();budget.charge('template',[1]);budget2=self.budget();budget2.charge('template',[2])
        self.assertIs(budget.state,budget2.state) # cases don't create budget partitions
        w1=self.ns['_Witness'](self.marker,self.actor,1,a,('x',),self.connection,self.raw)
        w2=self.ns['_Witness'](self.marker,self.actor,1,b,('x',),self.connection,self.raw)
        self.assertNotEqual(w1.case_id,w2.case_id)
        with self.assertRaises(AttributeError):w1.case_id=b
if __name__=='__main__':unittest.main()
