"""Extracted fixed entry/selector with fake ORM, snapshot and signing transport.

No SQL, native permissions, cryptography or route execution is claimed.
"""
import ast,json,sys,unittest
from pathlib import Path
from dataclasses import dataclass,replace
from types import SimpleNamespace as N,ModuleType
from uuid import UUID,uuid4
from unittest.mock import patch
ROOT=Path(__file__).resolve().parents[1]
D={'claim':'documents.template_claims','resolution':'documents.template_resolutions','retraction':'documents.template_retractions'}
class Hold(Exception):pass
class EntryTests(unittest.TestCase):
    def setUp(self):
        self.marker={};self.case=uuid4();self.keys=sorted(D.values());self.fresh=N(pk=9);self.server=N(pk=1)
        self.connection=object();self.raw=object();self.events=[];self.inside=False;self.denied=None;self.reject_id=None;self.mutate=False
        self.data={k:[] for k in D};self.owner_calls=0;self.worklists=[];self.authorizations=0;owner=self
        class Budget:
            def __init__(self,actor,keys):
                self.guard=N(marker=owner.marker,keys=tuple(sorted(keys)),connection=owner.connection,raw_connection=owner.raw,charge=lambda kind,ids:owner.events.append(('charge',kind,tuple(ids))))
            def phase(self):
                self.context();owner.events.append(('phase',))
            def context(self):
                if owner.marker.get('policy_budget_v2_failed'):raise Hold('poison')
            def poison(self):owner.marker['policy_budget_v2_failed']=True
        class Query:
            def __init__(self,kind):self.kind=kind;self.kw={}
            def only(self,*args):return self
            def get(self,**kw):
                owner.events.append(('lookup',self.kind));owner.assertTrue(owner.inside);return N(pk=kw['pk'])
            def filter(self,**kw):
                owner.events.append(('lookup',self.kind));owner.assertTrue(owner.inside);q=Query(self.kind);q.kw=kw;return q
            def values_list(self,*args,**kw):self.fields=args;return self
            def first(self):
                if self.kind=='config':return (7,owner.case,'D11.template_storage_retention_rules',1)
                if self.kind=='application':return None
                raise AssertionError(self.kind)
            def exists(self):return True
            def order_by(self,*args):return self
            def __getitem__(self,sl):
                kw=self.kw
                field='claim__scope__case_id' if self.kind=='retraction' else 'scope__case_id'
                ids=[row['pk'] for row in owner.data[self.kind] if row['case']==kw[field] and row['policy']==kw['owner_policy_id'] and row['pk']>kw['pk__gt']]
                result=sorted(ids)[sl];owner.events.append(('selected',self.kind,tuple(result),sl.stop));return result
        def require(actor,case,action):
            owner.assertIs(actor,owner.fresh);owner.events.append(('grant',action));owner.authorizations+=1
            if owner.denied==action:raise Hold('denied')
        def poison(marker):
            if marker is not None:marker['policy_budget_v2_failed']=True
        def selected(keys):
            if type(keys) is not list or not keys or any(type(k) is not str or k not in D.values() for k in keys) or len(set(keys))!=len(keys):raise Hold()
            return tuple(sorted(keys))
        def snapshot(server,keys,callback):
            owner.events.append(('snapshot',tuple(keys)));owner.inside=True
            try:return callback(owner.fresh)
            finally:owner.inside=False
        class Signing:
            @staticmethod
            def dumps(value,**kw):owner.events.append(('token',));return 'signed:'+json.dumps(value)
            @staticmethod
            def loads(value,**kw):
                owner.assertEqual(kw,{'salt':'psl.template-owner-impact-page/v1','max_age':3600})
                if not value.startswith('signed:'):raise Hold()
                return json.loads(value[7:])
        ns={'__name__':'entry_pure','__package__':'apps.documents','dataclass':dataclass,'ValidationError':Hold,'PermissionDenied':Hold,'DOMAINS':D,
            '_Budget':Budget,'_CONTEXT':N(get=lambda:self.marker),'_poison_marker':poison,'case_uuid':lambda v:v if type(v) is UUID else UUID(v),
            'require':require,'selected':selected,'_run_authenticated':snapshot,'signing':Signing,'materialize':lambda v:(owner.events.append(('materialize',)) or v)}
        for name,kind in [('Case','case'),('Grant','grant'),('Configuration','config'),('ScopeApplication','application'),('TemplateClaim','claim'),('TemplateResolution','resolution'),('TemplateClaimRetraction','retraction')]:ns[name]=N(objects=Query(kind))
        tree=ast.parse((ROOT/'apps/documents/template_impact_entry.py').read_text())
        exec(compile(ast.Module(body=[n for n in tree.body if not isinstance(n,(ast.Import,ast.ImportFrom))],type_ignores=[]),'<entry>','exec'),ns);self.ns=ns
        def producer(actor,case,selections,keys,_selector=None):
            ns['validate_selector'](actor,keys,case,selections,_selector)
            work=N(selector=_selector,closure=N(_records=tuple(sorted((k,pk) for k,ids in selections.items() for pk in ids))))
            ns['bind_selector'](actor,keys,case,selections,_selector,work);owner.worklists.append(work);return work
        ns['discover_candidate_worklist']=producer
        def projection(actor,keys,work,config):
            owner.owner_calls+=1
            if owner.reject_id in [pk for k,pk in work.closure._records]:raise Hold('inaccessible sentinel')
            result=[dict(id=pk,kind=k,metadata_only=True,domain_route='documents',owner_policy=7,state='historical_owner_record_not_template_selection',effects_performed=False,**({'historical_retraction_recorded':True} if k=='retraction' else {'owner_authority_pin_current':False})) for k,pk in work.closure._records]
            if owner.mutate:owner.data['claim'].append({'pk':999,'case':owner.case,'policy':7})
            return result
        module=ModuleType('apps.policy.template_owner_prepared');module.owner_current_metadata=projection
        p=patch.dict(sys.modules,{'apps.policy.template_owner_prepared':module});p.start();self.addCleanup(p.stop)
    def put(self,kind,ids,case=None,policy=7):self.data[kind].extend({'pk':pk,'case':case or self.case,'policy':policy} for pk in ids)
    def page(self,limit=25,cursor=None,keys=None):return self.ns['template_owner_page'](self.server,self.case,7,keys or self.keys,cursor,limit)
    def batch(self):return self.ns['template_owner_batch'](self.server,self.case,7,self.keys)
    def test_snapshot_fresh_actor_before_all_lookups(self):
        self.put('claim',[1]);out=self.page();self.assertEqual(self.events[0][0],'snapshot');self.assertEqual(len(out['domains'][D['claim']]),1)
        self.assertEqual(self.marker['template_owner_selectors803'][0]['phase'],'complete')
    def test_cross_key_cursor_last_emitted_not_sentinel(self):
        self.put('claim',[1,2]);self.put('resolution',[1]);out=self.page(2)
        token=json.loads(out['next_cursor'][7:]);self.assertEqual(token['after'],[D['claim'],2]);self.assertEqual(token['keys'],self.keys);self.assertEqual(token['actor'],9)
        self.assertEqual(self.worklists[0].closure._records,(('claim',1),('claim',2),('resolution',1)))
        self.marker={};self.worklists=[];next_page=self.page(2,out['next_cursor'])
        self.assertEqual(next_page['domains'][D['claim']],[]);self.assertEqual(next_page['domains'][D['resolution']][0]['id'],1)
    def test_page50_admits_only51_total(self):
        self.put('claim',range(1,41));self.put('resolution',range(1,50));out=self.page(50)
        self.assertEqual(sum(map(len,out['domains'].values())),50);self.assertEqual(len(self.worklists[0].closure._records),51)
        self.assertEqual([e[3] for e in self.events if e[0]=='selected'][:2],[51,11])
    def test_batch100_and101_hold_no_partial(self):
        self.put('claim',range(1,71));self.put('resolution',range(1,31));out=self.batch();self.assertEqual(sum(map(len,out['domains'].values())),100)
        self.setUp();self.put('claim',range(1,71));self.put('resolution',range(1,32))
        with self.assertRaises(Hold):self.batch()
        self.assertEqual(self.owner_calls,0);self.assertNotIn(('materialize',),self.events);self.assertTrue(self.marker['policy_budget_v2_failed'])
    def test_empty_full_key_authorization_no_fake_worklist(self):
        out=self.batch();self.assertEqual(out['domains'],{key:[] for key in self.keys});self.assertEqual(self.owner_calls,0);self.assertEqual(self.worklists,[])
        self.assertEqual(self.events.count(('grant','document.read')),6)
    def test_empty_unauthorized_key_still_denies(self):
        self.denied='document.read'
        with self.assertRaises(Hold):self.page()
        self.assertFalse(any(e[0]=='selected' for e in self.events));self.assertNotIn(('materialize',),self.events)
    def test_mixed_rows_one_owner_pipeline_and_no_retraction_boolean(self):
        for k in D:self.put(k,[1])
        out=self.batch();self.assertEqual(self.owner_calls,1)
        self.assertNotIn('owner_authority_pin_current',out['domains'][D['retraction']][0])
    def test_wrong_case_config_null_policy_excluded(self):
        self.put('claim',[1]);self.put('claim',[2],case=uuid4());self.put('claim',[3],policy=8);self.put('claim',[4],policy=None)
        self.assertEqual([r['id'] for r in self.batch()['domains'][D['claim']]],[1])
    def test_sentinel_denial_prevents_rows_and_token(self):
        self.put('claim',[1,2]);self.reject_id=2
        with self.assertRaises(Hold):self.page(1)
        self.assertNotIn(('token',),self.events);self.assertNotIn(('materialize',),self.events)
    def test_empty_final_selector_mutation_holds(self):
        original=self.ns['_select'];calls=[]
        def select(*a):
            calls.append(1)
            if len(calls)==2:self.put('claim',[1])
            return original(*a)
        self.ns['_select']=select
        with self.assertRaises(Hold):self.batch()
        self.assertEqual(self.worklists,[]);self.assertNotIn(('materialize',),self.events)
    def test_final_inventory_mutation_holds(self):
        self.put('claim',[1]);self.mutate=True
        with self.assertRaises(Hold):self.batch()
        self.assertNotIn(('materialize',),self.events)
    def test_cursor_fullkeys_actor_case_config_purpose_types(self):
        value={'version':1,'purpose':'page','actor':9,'case':str(self.case),'configuration':7,'keys':self.keys,'after':[D['claim'],1]}
        for name,bad in [('version',True),('purpose','batch'),('actor',1),('case',str(uuid4())),('configuration',8),('keys',[D['claim']]),('after',[D['claim'],True])]:
            with self.subTest(field=name):
                cursor='signed:'+json.dumps(dict(value,**{name:bad}))
                with self.assertRaises(Hold):self.ns['_after'](cursor,self.fresh,self.case,7,self.keys)
    def test_invalid_limit_or_keys_before_entry(self):
        with self.assertRaises(Hold):self.page(True)
        with self.assertRaises(Hold):self.ns['template_owner_batch'](self.server,self.case,7,[D['claim'],D['claim']])
        self.assertEqual(self.events,[])
    def test_projection_is_closed_no_private_fields_or_false_retraction(self):
        item=dict(id=1,kind='retraction',metadata_only=True,domain_route='documents',owner_policy=7,state='historical_owner_record_not_template_selection',effects_performed=False,historical_retraction_recorded=True)
        for bad in [dict(item,body='private'),dict(item,historical_retraction_recorded=False),dict(item,id=True),dict(item,owner_policy=8)]:
            with self.assertRaises(Hold):self.ns['_projected']([bad],((D['retraction'],1),),7)
    def selector(self):
        w=self.ns['_Selector'](self.marker,self.fresh,self.fresh.pk,self.connection,self.raw,self.case,7,tuple(self.keys),'page',None,26,((D['claim'],1),),())
        self.marker['template_owner_selectors803']=[{'witness':w,'phase':'issued','worklist':None}];return w
    def test_subset_witness_bound_rechecks_and_no_fresh_producer(self):
        w=self.selector();selections={'claim':[1]};work=N(selector=w)
        self.ns['validate_selector'](self.fresh,self.keys,self.case,selections,w)
        self.ns['bind_selector'](self.fresh,self.keys,self.case,selections,w,work)
        self.ns['validate_selector'](self.fresh,self.keys,self.case,selections,w,work)
        with self.assertRaises(Hold):self.ns['validate_selector'](self.fresh,self.keys,self.case,selections,w)
    def test_selector_copy_membership_bool_and_terminal_fail(self):
        for variant in ['copy','ids','bool','terminal']:
            self.setUp();w=self.selector();choices={'claim':[1]}
            if variant=='copy':w=replace(w)
            if variant=='ids':choices={'claim':[2]}
            if variant=='bool':choices={'claim':[True]}
            if variant=='terminal':self.marker['template_owner_selectors803'][0]['phase']='complete'
            with self.assertRaises(Hold):self.ns['validate_selector'](self.fresh,self.keys,self.case,choices,w)
            self.assertTrue(self.marker['policy_budget_v2_failed'])
    def test_old_selector_poisons_both_markers(self):
        w=self.selector();old=self.marker;self.marker={}
        with self.assertRaises(Hold):self.ns['validate_selector'](self.fresh,self.keys,self.case,{'claim':[1]},w)
        self.assertTrue(old['policy_budget_v2_failed']);self.assertTrue(self.marker['policy_budget_v2_failed'])
    def test_actual_scalar_bridge_default_equality_and_bound_recheck(self):
        class Reached(Exception):pass
        def users():raise Reached()
        tree=ast.parse((ROOT/'apps/documents/template_scalar_closure.py').read_text())
        ns={'__package__':'apps.documents','DOMAINS':D,'MAX_SELECTED':100,'ValidationError':Hold,'MESSAGE':'hold','require_context_actor':lambda *a:None,'get_user_model':users}
        names={'hold','selection','_discover_template_owner_closure'}
        exec(compile(ast.Module(body=[n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name in names],type_ignores=[]),'<scalar-key-bridge>','exec'),ns)
        budget=N(keys=tuple(self.keys),context=lambda:None,before_phase=lambda:None)
        with self.assertRaises(Hold):ns['_discover_template_owner_closure'](self.fresh,self.case,{'claim':[1]},budget)
        module=ModuleType('apps.documents.template_impact_entry');module.validate_selector=self.ns['validate_selector']
        w=self.selector();work=N(selector=w)
        with patch.dict(sys.modules,{'apps.documents.template_impact_entry':module}):
            with self.assertRaises(Reached):ns['_discover_template_owner_closure'](self.fresh,self.case,{'claim':[1]},budget,_selector=w)
            self.ns['bind_selector'](self.fresh,self.keys,self.case,{'claim':[1]},w,work)
            with self.assertRaises(Reached):ns['_discover_template_owner_closure'](self.fresh,self.case,{'claim':[1]},budget,_selector=w,_worklist=work)
    def test_actual_producer_binds_exact_selector_before_return(self):
        from tests import test_template_candidate_worklist803_component as original
        f=original.CandidateTests();f.setUp();f.producer_fakes()
        self.marker=f.marker;self.fresh=f.actor;self.connection=f.connection;self.raw=f.raw
        w=self.selector();seen=[]
        def closure(actor,case,selections,budget,**kw):
            self.assertIs(kw['_selector'],w);seen.append(1);return N(_templates=(2,8))
        f.ns['discover_template_owner_closure']=closure
        f.ns['__package__']='apps.documents'
        module=ModuleType('apps.documents.template_impact_entry');module.bind_selector=self.ns['bind_selector']
        with patch.dict(sys.modules,{'apps.documents.template_impact_entry':module}):
            work=f.ns['discover_candidate_worklist'](self.fresh,self.case,{'claim':[1]},self.keys,_selector=w)
        self.assertIs(work.selector,w);self.assertIs(self.marker['template_owner_selectors803'][0]['worklist'],work)
        self.assertEqual(self.marker['template_owner_selectors803'][0]['phase'],'bound');self.assertEqual(seen,[1])

class MixedOwnerTests(unittest.TestCase):
    def setUp(self):
        self.marker={};self.actor=N(pk=9);self.case=uuid4();self.calls=[];self.mutate=False;owner=self
        self.work=N(selector=object(),closure=N(_records=(('claim',1),('resolution',2),('retraction',3))))
        self.witness=N(marker=self.marker,case_id=self.case)
        self.rows={'claim':[(1,11,3,7)],'resolution':[(2,12,4,7)],'retraction':[(3,13,19,7)]}
        class Q:
            def __init__(self,kind):self.kind=kind
            def filter(self,**kw):return self
            def order_by(self,*a):return self
            def values_list(self,*fields):owner.calls.append(('fields',self.kind,fields));return self
            def __getitem__(self,sl):return owner.rows[self.kind][:sl.stop]
        class Budget:
            def __init__(self,*a):pass
            def phase(self):pass
            def poison(self):owner.marker['policy_budget_v2_failed']=True
        class Reader:
            def __init__(self,actor,keys,work,permit):self.permit=permit
            def evaluate(self,kind,pk):
                owner.calls.append(('owner',kind,pk))
                if owner.mutate and kind=='resolution':owner.rows['retraction']=[(3,13,20,7)]
                return True
        ns={'__package__':'apps.policy','dataclass':dataclass,'OwnerReader':Reader,'PreparedOwnerStop':Hold,
            'check_registered_worklist':lambda *a:self.witness,'_poison_marker':lambda m:m.update(policy_budget_v2_failed=True),'_CONTEXT':N(get=lambda:self.marker)}
        for kind,name in [('claim','TemplateClaim'),('resolution','TemplateResolution'),('retraction','TemplateClaimRetraction')]:ns[name]=N(objects=Q(kind))
        tree=ast.parse((ROOT/'apps/policy/template_owner_prepared.py').read_text())
        nodes=[n for n in tree.body if isinstance(n,(ast.FunctionDef,ast.ClassDef)) and n.name in ('_Permit','owner_current_metadata')]
        exec(compile(ast.Module(body=nodes,type_ignores=[]),'<mixed-owner-coordinator>','exec'),ns);self.ns=ns
        hist=ModuleType('apps.documents.template_historical_metadata')
        def historical(*a):
            self.calls.append(('historical',));return [dict(kind=k,id=pk) for k,pk in self.work.closure._records]
        hist.historical_metadata=historical
        candidate=ModuleType('apps.documents.template_candidate_worklist');candidate._Budget=Budget
        entry=ModuleType('apps.documents.template_impact_entry');entry.validate_selector=lambda *a:self.calls.append(('selector',))
        p=patch.dict(sys.modules,{'apps.documents.template_historical_metadata':hist,'apps.documents.template_candidate_worklist':candidate,'apps.documents.template_impact_entry':entry});p.start();self.addCleanup(p.stop)
    def run_mixed(self):return self.ns['owner_current_metadata'](self.actor,sorted(D.values()),self.work,7)
    def test_single_historical_pass_owner_only_claim_resolution(self):
        output=self.run_mixed();self.assertEqual(self.calls.count(('historical',)),1)
        self.assertEqual([c for c in self.calls if c[0]=='owner'],[('owner','claim',1),('owner','resolution',2)])
        self.assertNotIn('owner_authority_pin_current',output[-1])
    def test_retraction_relation_rechecked_after_owner_evaluation(self):
        self.mutate=True
        with self.assertRaises(Hold):self.run_mixed()
        self.assertTrue(self.marker['policy_budget_v2_failed'])
    def test_retraction_only_creates_no_owner_permits(self):
        self.work.closure._records=(('retraction',3),);output=self.run_mixed()
        self.assertEqual(self.marker['template_owner_permits803'],[]);self.assertEqual(output,[{'kind':'retraction','id':3}])
    def test_old_no_selector_contract_still_rejects_retractions(self):
        self.work.selector=None
        with self.assertRaises(Hold):self.run_mixed()
        self.assertNotIn(('historical',),self.calls)
