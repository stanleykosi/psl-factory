"""Pure registered producer/consumer checks; no native permissions or SQL."""
import ast,unittest
from pathlib import Path
from types import SimpleNamespace
from uuid import uuid4
from tests import test_template_candidate_worklist803_component as f
class ConsumerTests(unittest.TestCase):
    setUp=f.CandidateTests.setUp
    producer_fakes=f.CandidateTests.producer_fakes
    budget=f.CandidateTests.budget
    def produce(self):
        self.producer_fakes();row=list(self.pmo_rows[0]);row[2]=6;row[3]=None;row[8]=uuid4();self.pmo_rows=[tuple(row)]
        return self.ns['discover_candidate_worklist'](self.actor,uuid4(),{},['documents.template_claims'])
    def consume(self,out,row=None):
        return self.ns['consume_pmo_candidate'](self.actor,['documents.template_claims'],out,out.pmo[0] if row is None else row)
    def test_shared_registered_producer_exact100_then101_sticky(self):
        self.producer_fakes();case=uuid4();outputs=[]
        for _ in range(100):
            outputs.append(self.ns['discover_candidate_worklist'](self.actor,case,{},['documents.template_claims']))
        state=self.marker['template_candidate_worklist803'];before=tuple(state['registered'])
        self.assertEqual(len(before),100)
        self.assertTrue(all(saved is produced for saved,produced in zip(before,outputs)))
        with self.assertRaises(f.Hold):
            self.ns['discover_candidate_worklist'](self.actor,case,{},['documents.template_claims'])
        self.assertEqual(len(state['registered']),100)
        self.assertTrue(all(a is b for a,b in zip(before,state['registered'])))
        self.assertTrue(state['poison']);self.assertTrue(self.marker['policy_budget_v2_failed'])
        with self.assertRaises(f.Hold):self.budget()
    def test_actual_registered_producer_distinct_cases(self):
        out=self.produce();case,row=self.consume(out)
        self.assertEqual(case,out.witness.case_id);self.assertIs(row,out.pmo[0]);self.assertNotEqual(case,row[7]);self.assertNotEqual(case,row[8])
    def test_equal_unregistered_worklist_and_row_copies_rejected(self):
        for copied in ('worklist','row'):
            self.setUp();out=self.produce()
            if copied=='worklist':
                fake=self.ns['_Worklist'](out.closure,out.candidate_templates,out.finance,out.pmo,out.versions,out.witness)
                with self.assertRaises(f.Hold):self.consume(fake)
            else:
                row=tuple(list(out.pmo[0]));self.assertEqual(row,out.pmo[0]);self.assertIsNot(row,out.pmo[0])
                with self.assertRaises(f.Hold):self.consume(out,row)
            self.assertTrue(self.marker['policy_budget_v2_failed'])
    def test_context_rollover_poison_both_and_fresh_wrapper_denied(self):
        out=self.produce();old=self.marker;self.marker={}
        with self.assertRaises(f.Hold):self.consume(out)
        self.assertTrue(old['policy_budget_v2_failed']);self.assertTrue(self.marker['policy_budget_v2_failed'])
        with self.assertRaises(f.Hold):self.budget()
    def test_actor_pk_keys_connection_and_raw_mismatch(self):
        for field in ('actor','pk','keys','connection','raw'):
            self.setUp();out=self.produce();keys=['documents.template_claims']
            if field=='actor':self.actor=SimpleNamespace(pk=1)
            elif field=='pk':self.actor.pk=2
            elif field=='keys':keys=['documents.template_resolutions']
            else:setattr(self,field,object())
            with self.assertRaises(f.Hold):self.ns['consume_pmo_candidate'](self.actor,keys,out,out.pmo[0])
            self.assertTrue(out.witness.marker['policy_budget_v2_failed'])
    def test_constructor_consumes_before_scalar_and_has_no_invented_gate(self):
        tree=ast.parse((Path(__file__).resolve().parents[1]/'apps/pmo/template_prepared_reader.py').read_text())
        cls=next(n for n in tree.body if isinstance(n,ast.ClassDef) and n.name=='PreparedLeadershipReader')
        node=next(n for n in cls.body if isinstance(n,ast.FunctionDef) and n.name=='__init__')
        class Imports(ast.NodeTransformer):
            def visit_ImportFrom(self,node):return None
        node=Imports().visit(node);events=[];out=self.produce()
        def consume(*args):events.append('consume');return self.ns['consume_pmo_candidate'](*args)
        ns={'consume_pmo_candidate':consume,'PMOLedger':lambda *args:SimpleNamespace(poison=lambda:events.append('poison')),'poison_active_entry':lambda:events.append('active-poison')}
        exec(compile(ast.fix_missing_locations(ast.Module(body=[node],type_ignores=[])),'<constructor>','exec'),ns)
        obj=SimpleNamespace(_version_identity=lambda:events.append('scalar'))
        ns['__init__'](obj,self.actor,['documents.template_claims'],out,out.pmo[0])
        self.assertEqual(events,['consume','scalar']);self.assertEqual(obj.template_case_id,out.witness.case_id)
        self.assertNotIn('require(',ast.unparse(node))
        events.clear();bad=object()
        with self.assertRaises(f.Hold):ns['__init__'](obj,self.actor,['documents.template_claims'],bad,out.pmo[0])
        self.assertNotIn('scalar',events)
