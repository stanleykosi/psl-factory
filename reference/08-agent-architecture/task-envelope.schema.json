{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed PSL task invocation envelope",
  "description": "Design schema only. Passing schema validation does not grant permission or validate business semantics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenant_id",
    "case_id",
    "task_id",
    "process_ids",
    "capability_id",
    "purpose",
    "principal_ref",
    "grant_ref",
    "workflow_version",
    "policy_version",
    "input_refs",
    "expected_state_version",
    "allowed_operations",
    "completion_contract",
    "execution_kind",
    "effect_class",
    "bounds",
    "tool_contract_versions"
  ],
  "properties": {
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "description": "Required authenticated tenant namespace; PSL is the first policy pack, not a hard-coded global tenant."
    },
    "case_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable business-case reference; may link engagement, project, transaction or report through owning records."
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable task identity; attempts have separate attempt_id."
    },
    "process_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(B(0[1-9]|1[0-4])|F(0[1-9]|[1-3][0-9]|4[0-5])|P(0[1-9]|[1-5][0-9]|6[0-3]))$"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "capability_id": {
      "type": "string",
      "minLength": 1,
      "description": "Registered capability with a pinned contract version."
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "description": "Declared business purpose constrained by policy."
    },
    "principal_ref": {
      "type": "string",
      "minLength": 1,
      "description": "Verified human/service identity attached by runtime."
    },
    "grant_ref": {
      "type": "string",
      "minLength": 1,
      "description": "Runtime-verified, short-lived, purpose/resource/action-scoped grant; not a model-generated permission."
    },
    "workflow_version": {
      "type": "string",
      "minLength": 1,
      "description": "Pinned owner-reviewed workflow definition."
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "description": "Pinned policy version plus current revocation checks."
    },
    "tool_contract_versions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "description": "Keys must also resolve to registered operations; semantic gateway enforces allowlist and version compatibility."
    },
    "model_route_version": {
      "type": "string",
      "minLength": 1,
      "description": "Approved model/provider route and reasoning/tool settings."
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1,
      "description": "Versioned worker instructions, controlled outside agent authority."
    },
    "input_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "content_hash",
          "source_version",
          "access_label"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "content_hash": {
            "type": "string",
            "minLength": 1
          },
          "source_version": {
            "type": "string",
            "minLength": 1
          },
          "access_label": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "expected_state_version": {
      "type": "string",
      "minLength": 1,
      "description": "Concurrency precondition checked at action commit."
    },
    "approval_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "allowed_operations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "operation_key": {
      "type": "string",
      "minLength": 1,
      "description": "Stable semantic effect key; changed payload requires deliberate new operation/correction policy."
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_attempts",
        "max_task_depth",
        "max_fan_out",
        "max_elapsed_seconds",
        "max_no_progress_repetitions"
      ],
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "max_task_depth": {
          "type": "integer",
          "minimum": 1
        },
        "max_fan_out": {
          "type": "integer",
          "minimum": 1
        },
        "max_elapsed_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_no_progress_repetitions": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "completion_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_schema_id",
        "success_assertions",
        "failure_outcomes",
        "escalation_policy_ref"
      ],
      "properties": {
        "output_schema_id": {
          "type": "string",
          "minLength": 1
        },
        "success_assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "failure_outcomes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "escalation_policy_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "execution_kind": {
      "enum": [
        "model_task",
        "deterministic_task"
      ]
    },
    "effect_class": {
      "enum": [
        "read_analyze",
        "bounded_internal_write",
        "consequential_effect"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "execution_kind": {
            "const": "model_task"
          }
        },
        "required": [
          "execution_kind"
        ]
      },
      "then": {
        "required": [
          "model_route_version",
          "prompt_version"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "effect_class": {
            "enum": [
              "bounded_internal_write",
              "consequential_effect"
            ]
          }
        },
        "required": [
          "effect_class"
        ]
      },
      "then": {
        "required": [
          "operation_key"
        ]
      }
    }
  ]
}
