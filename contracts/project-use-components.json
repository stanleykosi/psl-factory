{
  "components": [
    {
      "id":"D06.import_unit_conversion","parent_decision_id":"D06",
      "schema_ref":"schema:psl/import-unit-conversion/v1","subject_scope":"One project's management accounts, entity, currency, period and declared feed.",
      "current_value":null,"status":"UNCONFIGURED",
      "value_schema":{"type":"object","additionalProperties":false,
        "required":["entity","period","currency","feed","units","control_total_unit","adjustment_unit"],
        "properties":{"entity":{"type":"string","minLength":1,"maxLength":100},
          "period":{"type":"string","pattern":"^[0-9]{4}-(0[1-9]|1[0-2])$"},
          "currency":{"type":"string","pattern":"^[A-Z]{3}$"},"feed":{"type":"string","minLength":1,"maxLength":100},
          "units":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["thousands_currency","millions_currency"]}},
          "control_total_unit":{"const":"as_declared_in_file"},"adjustment_unit":{"const":"major_currency"}}
      }
    },
    {
      "id": "OPS.department_assistant_use",
      "parent_decision_id": "OPS",
      "schema_ref": "schema:psl/department-assistant-use/v1",
      "subject_scope": "One project and its approved model and record types.",
      "status": "UNCONFIGURED",
      "current_value": null,
      "value_schema": {
        "type": "object", "additionalProperties": false,
        "required": ["personas", "provider", "model", "sources", "send_user_question"],
        "properties": {
          "personas": {"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["tola","chidi","zainab"]}},
          "provider": {"const":"openrouter"},
          "model": {"type":"string","minLength":1,"maxLength":180},
          "sources": {"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["packet","requirements","meeting","milestone","rfp_intake","handoff","bu_report","payroll_report","rfp_requirement","bid_record"]}},
          "send_user_question": {"const":true}
        }
      }
    },
    {
      "id":"OPS.payroll_chat_totals","parent_decision_id":"OPS",
      "schema_ref":"schema:psl/payroll-chat-totals/v1","subject_scope":"Current acknowledged aggregate reports in this project.",
      "current_value":null,"status":"UNCONFIGURED",
      "value_schema":{"type":"object","additionalProperties":false,"required":["audience","fields","delivery"],"properties":{
        "audience":{"const":"current_acknowledged_recipient"},
        "fields":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["eligible_total","by_bu"]}},
        "delivery":{"const":"local_reply_only"}
      }}
    },
    {
      "id":"OPS.winning_bid_reuse","parent_decision_id":"OPS",
      "schema_ref":"schema:psl/winning-bid-reuse/v1","subject_scope":"Exact winning answers this source project releases to named destination projects.",
      "current_value":null,"status":"UNCONFIGURED",
      "value_schema":{"type":"object","additionalProperties":false,"required":["answers"],"properties":{
        "answers":{"type":"array","minItems":1,"maxItems":40,"uniqueItems":true,"items":{
          "type":"object","additionalProperties":false,"required":["outcome_id","requirement","destination"],
          "properties":{"outcome_id":{"type":"integer","minimum":1},"requirement":{"type":"string","minLength":1,"maxLength":100},
            "destination":{"type":"string","format":"uuid"}}
        }}
      }}
    }
  ],
  "operation_dependencies":[]
}
