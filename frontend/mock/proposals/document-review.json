{
  "$comment": "F-29 contract overlay (mock only). document_response is the typed E-DOCUMENT body (document_id, version, title, status, template, body_url, test_template) plus PROPOSED fields for the backend developer: case_id, project_title, reference (G-SCR08-6); sections[] with changed_since and notes[] (G-SCR08-1, -2); checks[] computed by the backend (G-SCR08-3); audience, review {role_label, work_id, task_id}, drafted_by (G-SCR08-5); returned {by, role, at, note?} (G-SCR08-7). No version history, compare or draft operation is proposed here (G-SCR08-4, G-SCR08-8). Every proposed field is optional.",
  "document_response": {
    "type": "object",
    "required": ["document_id", "version", "title", "status", "template", "body_url"],
    "properties": {
      "document_id": { "type": "string" },
      "version": { "type": "string" },
      "title": { "type": "string" },
      "status": { "type": "string" },
      "template": { "type": "string" },
      "body_url": { "type": "string" },
      "test_template": { "type": "boolean" },
      "case_id": { "type": "string", "minLength": 1 },
      "project_title": { "type": "string", "minLength": 1 },
      "reference": { "type": "string", "minLength": 1 },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["key", "heading", "text"],
          "properties": {
            "key": { "type": "string", "minLength": 1 },
            "heading": { "type": "string", "minLength": 1 },
            "text": { "type": "string", "description": "Plain text; paragraphs are separated by a blank line. Never HTML." },
            "changed_since": { "type": "boolean" },
            "notes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["agent", "text"],
                "properties": {
                  "agent": { "type": "string", "minLength": 1 },
                  "text": { "type": "string", "minLength": 1 },
                  "cites": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["label", "reference"],
                      "properties": { "label": { "type": "string" }, "reference": { "type": "string" } },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "checks": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["key", "label", "status"],
          "properties": {
            "key": { "type": "string", "minLength": 1 },
            "label": { "type": "string", "minLength": 1 },
            "status": { "type": "string", "enum": ["done", "held", "blocked", "unknown"] },
            "detail": { "type": "string" },
            "cite": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "audience": {
        "type": "object",
        "properties": { "label": { "type": "string", "minLength": 1 } },
        "additionalProperties": false
      },
      "review": {
        "type": "object",
        "properties": {
          "role_label": { "type": "string", "minLength": 1 },
          "work_id": { "type": "string", "minLength": 1 },
          "task_id": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      },
      "drafted_by": {
        "type": "object",
        "properties": {
          "agent": { "type": "string", "minLength": 1 },
          "from": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      },
      "returned": {
        "type": "object",
        "properties": {
          "by": { "type": "string" },
          "role": { "type": "string" },
          "at": { "type": "string", "format": "date-time" },
          "note": { "type": "string", "description": "Only sent to a person who may read it (INV-ACCESS)." }
        },
        "additionalProperties": false
      }
    }
  }
}
