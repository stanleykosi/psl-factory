{
  "$comment": "F-11 contract overlay (mock only). rules_response, save_body and evidence_response equal the v7 proposal operation schemas (D-SETUP-RULES-VIEW r1, architecture/packages/v7/openapi.json) plus the row field proof_case. Every field outside v4 is a proposal for the backend developer (T-SETUP).",
  "rules_response": {
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "component": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "object",
              "additionalProperties": true
            },
            "set": {
              "type": "boolean"
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            },
            "area": {
              "type": "string",
              "minLength": 1
            },
            "area_label": {
              "type": "string",
              "minLength": 1
            },
            "group": {
              "type": "string",
              "minLength": 1
            },
            "group_label": {
              "type": "string",
              "minLength": 1
            },
            "used_by": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "display_value": {
              "type": "string",
              "minLength": 1,
              "description": "Current value as text; absent when not set (the screen shows Not set)"
            },
            "link": {
              "type": "string",
              "minLength": 1,
              "description": "Screen the rule is edited on instead, e.g. costing-rule"
            },
            "holds_work": {
              "type": "boolean"
            },
            "effective_from": {
              "type": "string",
              "minLength": 1,
              "format": "date-time"
            },
            "can_change": {
              "type": "boolean"
            },
            "restricted": {
              "type": "boolean"
            },
            "editor": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "minLength": 1,
                  "enum": [
                    "role_set",
                    "read_only"
                  ]
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "role": {
                        "type": "string",
                        "minLength": 1
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "role",
                      "label"
                    ],
                    "additionalProperties": false
                  }
                },
                "selected": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            "proof_case": {
              "type": "object",
              "description": "F-11 PROPOSAL beyond v7 (Assumption A-3): the case a proof upload for this rule attaches to; absent means Proof is disabled",
              "properties": {
                "case_id": {
                  "type": "string",
                  "minLength": 1
                },
                "case_revision": {
                  "type": "integer",
                  "minimum": 1
                },
                "evidence_kind": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "case_id",
                "case_revision",
                "evidence_kind"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "component",
            "name",
            "set",
            "revision"
          ],
          "additionalProperties": false
        }
      },
      "next_cursor": {
        "type": "string"
      },
      "as_of": {
        "type": "string",
        "minLength": 1,
        "format": "date-time"
      },
      "not_set_count": {
        "type": "integer",
        "minimum": 0
      },
      "roles_missing_count": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "items",
      "as_of"
    ],
    "additionalProperties": false
  },
  "save_body": {
    "type": "object",
    "properties": {
      "expected_revision": {
        "type": "integer",
        "minimum": 0,
        "description": "PROPOSAL (D-SETUP-RULES-VIEW): the revision exactly as read; 0 saves the first version of a rule that is Not set (fixes the v6 minimum of 1, which made a first save impossible)"
      },
      "value": {
        "type": "object",
        "additionalProperties": true
      },
      "starts": {
        "type": "string",
        "minLength": 1,
        "format": "date"
      },
      "reason": {
        "type": "string",
        "minLength": 1
      },
      "evidence_id": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "expected_revision",
      "value"
    ],
    "additionalProperties": false
  },
  "evidence_response": {
    "type": "object",
    "properties": {
      "evidence_id": {
        "type": "string",
        "minLength": 1
      },
      "sha256": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[0-9a-f]{64}$"
      },
      "case_revision": {
        "type": "integer",
        "minimum": 1,
        "description": "The case revision after the upload; send it as case_revision on the start, response or action that follows"
      }
    },
    "required": [
      "evidence_id",
      "sha256"
    ],
    "additionalProperties": false
  }
}
